{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "PowerShell(.\\scripts\\readonly\\*)",
      "PowerShell(./scripts/readonly/*)",
      "PowerShell(git status *)",
      "PowerShell(git status)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull --ff-only *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh issue view *)",
      "Edit(./knowledge/**)",
      "Edit(./runbooks/**)",
      "Edit(./requests/**)",
      "Edit(./reports/**)",
      "Edit(./tasks.md)"
    ],
    "ask": [
      "PowerShell(git switch -c *)",
      "PowerShell(git switch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push -u origin request/*)",
      "PowerShell(git push -u origin notes/*)",
      "PowerShell(git push origin request/*)",
      "PowerShell(git push origin notes/*)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr comment *)",
      "Edit(./CLAUDE.md)",
      "Edit(./README.md)",
      "Edit(./.gitignore)",
      "Edit(./.claude/**)",
      "Edit(./scripts/**)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "PowerShell(*Get-BitLockerKey*)",
      "PowerShell(git push origin main*)",
      "PowerShell(git push * main*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git branch -D *)",
      "PowerShell(git push * --delete *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh repo *)",
      "PowerShell(gh api *)",
      "PowerShell(gh secret *)",
      "PowerShell(gh workflow *)",
      "PowerShell(*Invoke-MgGraphRequest*POST*)",
      "PowerShell(*Invoke-MgGraphRequest*PATCH*)",
      "PowerShell(*Invoke-MgGraphRequest*PUT*)",
      "PowerShell(*Invoke-MgGraphRequest*DELETE*)",
      "PowerShell(*Invoke-RestMethod*)",
      "PowerShell(*Invoke-WebRequest*)",
      "PowerShell(*New-Mg*)",
      "PowerShell(*Update-Mg*)",
      "PowerShell(*Remove-Mg*)",
      "PowerShell(*Set-Mg*)",
      "PowerShell(*Set-AutopilotUser*)",
      "PowerShell(*Set-DeviceUser*)",
      "PowerShell(*Remove-DeviceRecords*)",
      "PowerShell(*Revoke-*)",
      "PowerShell(*Remove-AuthMethods*)",
      "PowerShell(terraform *)",
      "PowerShell(az *)",
      "PowerShell(*Connect-ExchangeOnline*)",
      "PowerShell(*Connect-IPPSSession*)",
      "PowerShell(*Connect-SPOService*)",
      "PowerShell(*Connect-MgGraph*-Scopes*Write*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pfx)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
